---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
}

const { title, description, image, alt, tags } = Astro.props;
---

<article class="project-card">
  <div class="project-image-wrap">
    <img src={image} alt={alt} loading="lazy" />
  </div>
  <div class="project-copy">
    <h3>{title}</h3>
    <p>{description}</p>
    <TagList tags={tags} />
  </div>
</article>

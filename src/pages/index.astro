---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagList from '../components/TagList.astro';
import { projects, skills } from '../data/portfolio';
---

<BaseLayout
  title="Nofer — Technical Artist & Developer"
  description="Portfolio of Nofer, a technical artist and developer focused on real-time rendering, game tools, and graphics programming."
>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Nofer, home">NOFER<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Technical artist · Developer</p>
        <h1 id="hero-title">I build tools and visuals for <em>real-time worlds.</em></h1>
        <p class="hero-intro">
          I’m Nofer, a computer science student at Boston University working across graphics programming,
          game development, and technical art.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#work">Explore my work</a>
          <a class="text-link" href="/resume.pdf">View résumé <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/images/black-hole-hero.png" alt="" />
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
      </div>
      <p class="hero-index">01 / Portfolio</p>
    </section>

    <section class="section" id="about">
      <SectionHeading
        eyebrow="Capabilities"
        title="Code, art, and the space between."
        description="My toolkit spans low-level rendering, gameplay systems, content tools, and the production pipelines that connect them."
      />
      <div class="skill-grid">
        {skills.map((skill, index) => (
          <article class="skill-card">
            <p class="card-number">0{index + 1}</p>
            <h3>{skill.title}</h3>
            <TagList tags={skill.items} />
          </article>
        ))}
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <SectionHeading eyebrow="Experience" title="Building for production." />
      <div class="experience-list">
        <article class="experience-item">
          <p class="experience-year">2025</p>
          <div>
            <h3>Technical Artist Intern</h3>
            <p class="company">Lilith Games</p>
          </div>
          <p>Created Unity and Blender tools, debugged a customized render pipeline, and built performance-critical shaders and scripts.</p>
        </article>
        <article class="experience-item">
          <p class="experience-year">2022—24</p>
          <div>
            <h3>Lead Programmer</h3>
            <p class="company">David’s Challenge Dev Team</p>
          </div>
          <p>Implemented core gameplay systems, led early prototyping, and helped expand and onboard the development team.</p>
        </article>
      </div>
    </section>

    <section class="section work-section" id="work">
      <SectionHeading
        eyebrow="Selected work"
        title="Experiments with a purpose."
        description="A mix of rendering research, rapid game development, and visual design."
      />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section class="contact-section" id="contact">
      <p class="eyebrow">Let’s make something</p>
      <h2>Have an interesting problem?</h2>
      <p>I’m seeking technical art, gameplay programming, and engine development opportunities in North America and Europe.</p>
      <a class="button button-light" href="mailto:noferssxue@gmail.com">noferssxue@gmail.com</a>
      <div class="social-links">
        <a href="https://github.com/nofer-x">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/nofer-xue">LinkedIn ↗</a>
      </div>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Nofer Xue</p>
    <a href="#top">Back to top ↑</a>
  </footer>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagList from '../components/TagList.astro';
import { projects, skills } from '../data/portfolio';
---

<BaseLayout
  title="Nofer — Technical Artist & Developer"
  description="Portfolio of Nofer, a technical artist and developer focused on real-time rendering, game tools, and graphics programming."
>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Nofer, home">NOFER</a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Graphics Developer · Technical artist</p>
        <h1 id="hero-title">Hi,  I'm  <em>Nofer</em></h1>
        <p class="hero-intro">
          I am a graduate student in <a href="https://www.cis.upenn.edu/mse-in-cggt/">
            Computer Graphics and Game Technology (CGGT)
          </a> at the <img class="hero-intro-logo" src="/images/upenn.png" alt="" /><a href="https://www.upenn.edu/">
            University of Pennsylvania
          </a>, and a former Technical Artist Intern at <img class="hero-intro-logo" src="/images/LilithGames_no_sub.png" alt="" /><a href="https://www.lilith.com/?locale=en_US">
            Lilith Games
          </a>.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#work">Explore my work</a>
          <a class="text-link" href="/resume.pdf">View résumé <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <SectionHeading
        eyebrow="SKILLS"
        title={"Technical  solutions\n for  your  creativity"}
        description="My study spans real-time rendering, gameplay systems, tool development, and the production pipelines that connect them."
      />
      <div class="skill-grid">
        {skills.map((skill, index) => (
          <article class="skill-card">
            <p class="card-number">0{index + 1}</p>
            <h3>{skill.title}</h3>
            <TagList tags={skill.items} />
          </article>
        ))}
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <SectionHeading eyebrow="Experience" title={"Tested  in  production"} />
      <div class="experience-list">
        <article class="experience-item">
          <p class="experience-year">2025</p>
          <div>
            <h3>Technical Artist Intern</h3>
            <p class="company">Lilith Games</p>
          </div>
          <p>
            I worked on the tools and visual effects behind a major game IP,
            building Unity and Blender utilities and developing shaders for performance-sensitive effects.
          </p>
        </article>
        <article class="experience-item">
          <p class="experience-year">2022—24</p>
          <div>
            <h3>Lead Programmer</h3>
            <p class="company">CWRU Educational Game Development Team</p>
          </div>
          <p>
            I helped bring educational games into local classrooms,
            developing and optimizing experiences that reached more than 250 students
            across three schools.
          </p>
        </article>
      </div>
    </section>

    <section class="section work-section" id="work">
      <SectionHeading
        eyebrow="Projects"
        title={"Honed  through  practice"}
        description="A mix of rendering research, rapid game prototyping, and visual design."
      />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section class="contact-section" id="contact">
      <p class="eyebrow">Have an interesting problem?</p>
      <h2>Let’s  build  something</h2>
      <p>I’m seeking technical art, engine development, and gameplay programming opportunities in North America and Europe.</p>
      <a class="button button-light" href="mailto:noferssxue@gmail.com">noferssxue@gmail.com</a>
      <div class="social-links">
        <a href="https://github.com/nofer-x">
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          GitHub ↗
        </a>
        <a href="https://www.linkedin.com/in/nofer-xue">
          <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          LinkedIn ↗
        </a>
      </div>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Nofer Xue</p>
    <a href="#top">Back to top ↑</a>
  </footer>

  <script>
    const scrollSections: HTMLElement[] = Array.from(
      document.querySelectorAll<HTMLElement>('main > section, body > footer')
    );
    const reducedMotion: MediaQueryList = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wheelThreshold: number = 24;
    const transitionDuration: number = 900;
    let accumulatedDelta: number = 0;
    let wheelLocked: boolean = false;

    function getClosestSectionIndex(): number {
      let closestIndex: number = 0;
      let closestDistance: number = Number.POSITIVE_INFINITY;

      for (let index: number = 0; index < scrollSections.length; index += 1) {
        const distance: number = Math.abs(scrollSections[index].getBoundingClientRect().top);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      }

      return closestIndex;
    }

    function navigateByWheel(direction: number): void {
      const currentIndex: number = getClosestSectionIndex();
      const targetIndex: number = Math.min(
        Math.max(currentIndex + direction, 0),
        scrollSections.length - 1
      );

      accumulatedDelta = 0;

      if (targetIndex === currentIndex) {
        return;
      }

      wheelLocked = true;
      scrollSections[targetIndex].scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
        block: 'start',
      });

      window.setTimeout((): void => {
        wheelLocked = false;
      }, reducedMotion.matches ? 0 : transitionDuration);
    }

    window.addEventListener('wheel', (event: WheelEvent): void => {
      if (event.ctrlKey || scrollSections.length < 2) {
        return;
      }

      event.preventDefault();

      if (wheelLocked) {
        return;
      }

      accumulatedDelta += event.deltaY;

      if (Math.abs(accumulatedDelta) < wheelThreshold) {
        return;
      }

      navigateByWheel(accumulatedDelta > 0 ? 1 : -1);
    }, { passive: false });
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagList from '../components/TagList.astro';
import { projects, skills } from '../data/portfolio';
---

<BaseLayout
  title="Nofer — Technical Artist & Developer"
  description="Portfolio of Nofer, a technical artist and developer focused on real-time rendering, game tools, and graphics programming."
>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Nofer, home">NOFER</a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Graphics Developer · Technical artist</p>
        <h1 id="hero-title">I build <em>technical solutions</em> for your creativity</h1>
        <p class="hero-intro">
          Hi! I’m Nofer, a graduate student in <a href="https://www.cis.upenn.edu/mse-in-cggt/">
            Computer Graphics and Game Technology (CGGT)
          </a> at the <img class="hero-intro-logo" src="/images/upenn.png" alt="" /><a href="https://www.upenn.edu/">
            University of Pennsylvania
          </a>, and a former Technical Artist Intern at <img class="hero-intro-logo" src="/images/LilithGames_no_sub.png" alt="" /><a href="https://www.lilith.com/?locale=en_US">
            Lilith Games
          </a>.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#work">Explore my work</a>
          <a class="text-link" href="/resume.pdf">View résumé <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <SectionHeading
        eyebrow="SKILLS"
        title="Code, design, and the space between."
        description="My study spans real-time rendering, gameplay systems, tool development, and the production pipelines that connect them."
      />
      <div class="skill-grid">
        {skills.map((skill, index) => (
          <article class="skill-card">
            <p class="card-number">0{index + 1}</p>
            <h3>{skill.title}</h3>
            <TagList tags={skill.items} />
          </article>
        ))}
      </div>
    </section>

    <section class="section experience-section" id="experience">
      <SectionHeading eyebrow="Experience" title="Building for production." />
      <div class="experience-list">
        <article class="experience-item">
          <p class="experience-year">2025</p>
          <div>
            <h3>Technical Artist Intern</h3>
            <p class="company">Lilith Games</p>
          </div>
          <p>Created Unity and Blender tools, debugged a customized render pipeline, and built performance-critical shaders and scripts.</p>
        </article>
        <article class="experience-item">
          <p class="experience-year">2022—24</p>
          <div>
            <h3>Lead Programmer</h3>
            <p class="company">David’s Challenge Dev Team</p>
          </div>
          <p>Implemented core gameplay systems, led early prototyping, and helped expand and onboard the development team.</p>
        </article>
      </div>
    </section>

    <section class="section work-section" id="work">
      <SectionHeading
        eyebrow="Selected work"
        title="Experiments with a purpose."
        description="A mix of rendering research, rapid game prototyping, and visual design."
      />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section class="contact-section" id="contact">
      <p class="eyebrow">Let’s build something</p>
      <h2>Have an interesting problem?</h2>
      <p>I’m seeking technical art, engine development, and gameplay programming opportunities in North America and Europe.</p>
      <a class="button button-light" href="mailto:noferssxue@gmail.com">noferssxue@gmail.com</a>
      <div class="social-links">
        <a href="https://github.com/nofer-x">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/nofer-xue">LinkedIn ↗</a>
      </div>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Nofer Xue</p>
    <a href="#top">Back to top ↑</a>
  </footer>
</BaseLayout>
